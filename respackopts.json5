{
  id: "OmnisEnchantments",
  version: 13,
  capabilities: [
    "FileFilter",
    "DirFilter",
    "DirFilterAdditive"
  ],
  conf: {
    General: {
      GlowingEffect: true,
      GlowIntensity: {
        type: "integer",
        default: 130,
        min: 0,
        max: 255
      },
      RunesParticles: true,
      RunesIntensity: {
        type: "integer",
        default: 5,
        min: 1,
        max: 9
      },
      RotateRunicParticles: false,
      ItemGlintStyle: {
        type: "enum",
        default: "Reworked",
        values: ["Reworked", "Vanilla", "Minimal", "NoGlint"]
      },
      ArmorGlintStyle: {
        type: "enum",
        default: "Reworked",
        values: ["Reworked", "Vanilla", "NoGlint"]
      },
      VibrantGlint: true,
      Outline: true,
      CustomModel: true,
      DynamicLight: true,
      DirectionalLight: false
    },
    GlowByItemType: {
      Swords: true,
      Pickaxes: true,
      Axes: true,
      Hoes: true,
      Shovels: true,
      Spears: true,
      Books: true,
      Rods: true,
      Shears: true,
      EnchantedGoldenApple: true,
      Armors: true,
      NautilusArmors: true,
      HorseArmors: true,
      WolfArmor: true,
      Mace: true,
      Bow: true,
      Crossbow: true,
      Trident: true,
      Shield: true,
      Brush: true,
      FlintAndSteel: true,
      Spyglass: true,
      Compasses: true,
      Clock: true,
      NetherStar: true,
      ExperienceBottle: true,
      Totem: true
    },
    RunesByItemType: {
      Swords: true,
      Pickaxes: true,
      Axes: true,
      Hoes: true,
      Shovels: true,
      Spears: true,
      Books: true,
      Rods: true,
      Shears: true,
      EnchantedGoldenApple: true,
      Armors: true,
      NautilusArmors: true,
      HorseArmors: true,
      WolfArmor: true,
      Mace: true,
      Bow: true,
      Crossbow: true,
      Trident: true,
      FlintAndSteel: true,
      Spyglass: true,
      Compasses: true,
      Clock: true,
      NetherStar: true,
      ExperienceBottle: true,
      EndCrystal: true
    },
    OutlineByItemType: {
      Swords: true,
      Pickaxes: true,
      Axes: true,
      Hoes: true,
      Shovels: true,
      Spears: true,
      Books: true,
      Rods: true,
      Shears: true,
      EnchantedGoldenApple: true,
      Armors: true,
      NautilusArmors: true,
      HorseArmors: true,
      WolfArmor: true,
      Mace: true,
      Bow: true,
      Crossbow: true,
      Trident: true,
      FlintAndSteel: true,
      Spyglass: true,
      Compasses: true,
      Clock: true,
      NetherStar: true,
      ExperienceBottle: true,
      Shield: true,
      Brush: true
    },
    CustomModelByItemType: {
      Swords: true,
      Pickaxes: true,
      Axes: true,
      Hoes: true,
      Shovels: true,
      Spears: true,
      Books: true,
      Rods: true,
      Shears: true,
      EnchantedGoldenApple: true,
      Armors: true,
      NautilusArmors: true,
      HorseArmors: true,
      WolfArmor: true,
      Mace: true,
      Bow: true,
      Crossbow: true,
      Trident: true,
      FlintAndSteel: true,
      Spyglass: true,
      Compasses: true,
      Clock: true,
      NetherStar: true,
      ExperienceBottle: true,
      Shield: true,
      Brush: true,
      EndCrystal: true
  },
    Compatibility: {
      Tools: {
        type: "enum",
        default: "Default",
        values: ["Default", "ClassicToolsFusion"]
      },
      Swords: {
        type: "enum",
        default: "Default",
        values: ["Default", "ClassicToolsFusion"]
      },
      Spears: {
        type: "enum",
        default: "Default",
        values: ["Default", "ClassicToolsFusion"]
      },
      Mace: {
        type: "enum",
        default: "Default",
        values: ["Default", "MaceFusion"]
      }
    }
  }
}
