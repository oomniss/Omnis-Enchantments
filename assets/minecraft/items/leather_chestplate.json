{
    "model": {
        "type": "minecraft:condition",
        "property": "minecraft:has_component",
        "component": "minecraft:enchantments",
        "ignore_default": true,
        "on_true": {
            "type": "minecraft:select",
            "property": "minecraft:display_context",
            "cases": [
                {
                    "when": "gui",
                    "model": {
                        "type": "minecraft:model",
                        "model": "minecraft:item/leather_chestplate",
                        "tints": [
                            {
                                "type": "minecraft:dye",
                                "default": -6265536
                            }
                        ]
                    }
                }
            ],
            "fallback": {
                "type": "minecraft:model",
                "model": "minecraft:item/chestplates/e_leather_chestplate",
                "tints": [
                    {
                        "type": "minecraft:dye",
                        "default": -6265536
                    }
                ]
            }
        },
        "on_false": {
            "type": "minecraft:model",
            "model": "minecraft:item/leather_chestplate",
            "tints": [
                {
                    "type": "minecraft:dye",
                    "default": -6265536
                }
            ]
        }
    }
}