{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/bow"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:use_duration",
        "scale": 0.05,
        "fallback": {
          "type": "minecraft:condition",
          "property": "minecraft:has_component",
          "component": "minecraft:enchantments",
          "ignore_default": true,
          "on_true": {
            "type": "minecraft:model",
            "model": "minecraft:item/bow/e_bow_pulling_0"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "minecraft:item/bow/bow_pulling_0"
          }
        },
        "entries": [
          {
            "threshold": 0.65,
            "model": {
              "type": "minecraft:condition",
              "property": "minecraft:has_component",
              "component": "minecraft:enchantments",
              "ignore_default": true,
              "on_true": {
                "type": "minecraft:model",
                "model": "minecraft:item/bow/e_bow_pulling_1"
              },
              "on_false": {
                "type": "minecraft:model",
                "model": "minecraft:item/bow/bow_pulling_1"
              }
            }
          },
          {
            "threshold": 0.9,
            "model": {
              "type": "minecraft:condition",
              "property": "minecraft:has_component",
              "component": "minecraft:enchantments",
              "ignore_default": true,
              "on_true": {
                "type": "minecraft:model",
                "model": "minecraft:item/bow/e_bow_pulling_2"
              },
              "on_false": {
                "type": "minecraft:model",
                "model": "minecraft:item/bow/bow_pulling_2"
              }
            }
          }
        ]
      },
      "on_false": {
        "type": "minecraft:condition",
        "property": "minecraft:has_component",
        "component": "minecraft:enchantments",
        "ignore_default": true,
        "on_true": {
          "type": "minecraft:model",
          "model": "minecraft:item/bow/e_bow"
        },
        "on_false": {
          "type": "minecraft:model",
          "model": "minecraft:item/bow"
        }
      }
    }
  }
}
