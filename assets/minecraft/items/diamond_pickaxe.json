{
    "model": {
        "type": "minecraft:condition",
        "property": "minecraft:has_component",
        "component": "minecraft:enchantments",
        "ignore_default": true,
        "on_true": {
            "type": "minecraft:model",
            "model": "minecraft:item/diamond_pickaxe_enchanted"
        },
        "on_false": {
            "type": "minecraft:model",
            "model": "minecraft:item/diamond_pickaxe"
        }
    }
}