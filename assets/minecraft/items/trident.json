{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:enchantments",
    "ignore_default": true,
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["gui", "ground", "fixed", "on_shelf"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/trident"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",
        "on_false": {
          "type": "minecraft:composite",
          "models": [
            {
              "type": "minecraft:special",
              "base": "minecraft:item/trident_in_hand",
              "model": { "type": "minecraft:trident" }
            },
            {
              "type": "minecraft:model",
              "model": "minecraft:item/others/e_trident_in_hand"
            }
          ]
        },
        "on_true": {
          "type": "minecraft:composite",
          "models": [
            {
              "type": "minecraft:special",
              "base": "minecraft:item/trident_throwing",
              "model": { "type": "minecraft:trident" }
            },
            {
              "type": "minecraft:model",
              "model": "minecraft:item/others/e_trident_throwing"
            }
          ]
        },
        "transformation": {
          "left_rotation": [0.0, 0.0, 0.0, 1.0],
          "right_rotation": [0.0, 0.0, 0.0, 1.0],
          "scale": [1.0, -1.0, -1.0],
          "translation": [0.0, 0.0, 0.0]
        }
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["gui", "ground", "fixed", "on_shelf"],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/trident"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",
        "on_false": {
          "type": "minecraft:special",
          "base": "minecraft:item/trident_in_hand",
          "model": { "type": "minecraft:trident" }
        },
        "on_true": {
          "type": "minecraft:special",
          "base": "minecraft:item/trident_throwing",
          "model": { "type": "minecraft:trident" }
        },
        "transformation": {
          "left_rotation": [0.0, 0.0, 0.0, 1.0],
          "right_rotation": [0.0, 0.0, 0.0, 1.0],
          "scale": [1.0, -1.0, -1.0],
          "translation": [0.0, 0.0, 0.0]
        }
      }
    }
  }
}