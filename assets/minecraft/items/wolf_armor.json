{
  "model": {
    "type": "minecraft:condition",
    "component": "minecraft:enchantments",
    "property": "minecraft:has_component",
    "on_false": {
      "type": "minecraft:condition",
      "component": "minecraft:dyed_color",
      "property": "minecraft:has_component",
      "on_false": {
        "type": "minecraft:model",
        "model": "minecraft:item/wolf_armor"
      },
      "on_true": {
        "type": "minecraft:model",
        "model": "minecraft:item/wolf_armor_dyed",
        "tints": [
          {
            "type": "minecraft:constant",
            "value": -1
          },
          {
            "type": "minecraft:dye",
            "default": 0
          }
        ]
      }
    },
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["gui", "ground"],
          "model": {
            "type": "minecraft:condition",
            "component": "minecraft:dyed_color",
            "property": "minecraft:has_component",
            "on_false": {
              "type": "minecraft:model",
              "model": "minecraft:item/wolf_armor"
            },
            "on_true": {
              "type": "minecraft:model",
              "model": "minecraft:item/wolf_armor_dyed",
              "tints": [
                {
                  "type": "minecraft:constant",
                  "value": -1
                },
                {
                  "type": "minecraft:dye",
                  "default": 0
                }
              ]
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
        "component": "minecraft:dyed_color",
        "property": "minecraft:has_component",
        "on_false": {
          "type": "minecraft:model",
          "model": "minecraft:item/others/e_wolf_armor"
        },
        "on_true": {
          "type": "minecraft:model",
          "model": "minecraft:item/others/e_wolf_armor_dyed",
          "tints": [
            {
              "type": "minecraft:constant",
              "value": -1
            },
            {
              "type": "minecraft:dye",
              "default": 0
            }
          ]
        }
      }
    }
  }
}