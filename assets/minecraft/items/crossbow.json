{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/crossbow"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:charge_type",
      "cases": [
        {
          "when": "arrow",
          "model": {
            "type": "minecraft:condition",
            "property": "minecraft:has_component",
            "component": "minecraft:enchantments",
            "ignore_default": true,
            "on_true": {
              "type": "minecraft:model",
              "model": "minecraft:item/crossbow/e_crossbow_arrow"
            },
            "on_false": {
              "type": "minecraft:model",
              "model": "minecraft:item/crossbow/crossbow_arrow"
            }
          }
        },
        {
          "when": "rocket",
          "model": {
            "type": "minecraft:condition",
            "property": "minecraft:has_component",
            "component": "minecraft:enchantments",
            "ignore_default": true,
            "on_true": {
              "type": "minecraft:model",
              "model": "minecraft:item/crossbow/e_crossbow_firework"
            },
            "on_false": {
              "type": "minecraft:model",
              "model": "minecraft:item/crossbow/crossbow_firework"
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",
        "on_true": {
          "type": "minecraft:range_dispatch",
          "property": "minecraft:crossbow/pull",
          "fallback": {
            "type": "minecraft:condition",
            "property": "minecraft:has_component",
            "component": "minecraft:enchantments",
            "ignore_default": true,
            "on_true": {
              "type": "minecraft:model",
              "model": "minecraft:item/crossbow/e_crossbow_pulling_0"
            },
            "on_false": {
              "type": "minecraft:model",
              "model": "minecraft:item/crossbow_pulling_0"
            }
          },
          "entries": [
            {
              "threshold": 0.58,
              "model": {
                "type": "minecraft:condition",
                "property": "minecraft:has_component",
                "component": "minecraft:enchantments",
                "ignore_default": true,
                "on_true": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow/e_crossbow_pulling_1"
                },
                "on_false": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_pulling_1"
                }
              }
            },
            {
              "threshold": 1.0,
              "model": {
                "type": "minecraft:condition",
                "property": "minecraft:has_component",
                "component": "minecraft:enchantments",
                "ignore_default": true,
                "on_true": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow/e_crossbow_pulling_2"
                },
                "on_false": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_pulling_2"
                }
              }
            }
          ]
        },
        "on_false": {
          "type": "minecraft:condition",
          "property": "minecraft:has_component",
          "component": "minecraft:enchantments",
          "ignore_default": true,
          "on_true": {
            "type": "minecraft:model",
            "model": "minecraft:item/crossbow/e_crossbow_standby"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "minecraft:item/crossbow"
          }
        }
      }
    }
  }
}